aws_region   = "us-east-1"
project_name = "gridguardian"
environment  = "dev"

github_repository       = "agabrielcorujo/GridGuardian"
# IDs from GitHub's repository API; required by this repository's OIDC subject.
github_owner_id         = "148304752"
github_repository_id    = "1449534292"
github_publish_branches = ["main", "aws-infra", "api"]
# If GitHub's OIDC provider already exists in the account, use its ARN instead.
github_oidc_provider_arn = null

images_bucket_name = "grid-guardian-images"
reports_table_name = "GridGuardian"

# First apply: leave this null to provision infrastructure without Lambda.
# After pushing the worker to ECR: replace null with its immutable image tag.
image_tag = null

image_prefix       = "images/"
bedrock_model_id    = "us.amazon.nova-2-lite-v1:0"
lambda_timeout     = 180
lambda_memory_size = 512

# Initial API digest; keep available after Actions takes over API releases.
api_image_digest = "sha256:REPLACE_WITH_64_HEX_CHARACTERS_FROM_THE_API_IMAGE"
